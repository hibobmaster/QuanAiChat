{
  "name": "quanaichat",
  "version": "3.0.2",
  "private": false,
  "license": "mit",
  "browserslist": [
    "> 0.25%",
    "not dead"
  ],
  "scripts": {
    "mask": "tsx --no-deprecation app/masks/build.ts",
    "mask:watch": "tsx watch --no-deprecation app/masks/build.ts",
    "dev": "concurrently -r \"pnpm run mask:watch\" \"cross-env NODE_OPTIONS=--no-deprecation next dev\"",
    "build": "pnpm mask && cross-env BUILD_MODE=standalone next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "export": "pnpm mask && cross-env BUILD_MODE=export next build",
    "export:dev": "concurrently -r \"pnpm mask:watch\" \"cross-env NODE_OPTIONS=--no-deprecation BUILD_MODE=export next dev\"",
    "prompts": "node ./scripts/fetch-prompts.mjs",
    "prepare": "husky",
    "proxy-dev": "sh ./scripts/init-proxy.sh && proxychains -f ./scripts/proxychains.conf pnpm dev",
    "test": "jest --watch",
    "test:ci": "jest --ci"
  },
  "dependencies": {
    "@fortaine/fetch-event-source": "^3.0.6",
    "@hello-pangea/dnd": "^18.0.1",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "@pydantic/monty": "^0.0.17",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-toast": "^1.2.15",
    "@svgr/webpack": "^8.1.0",
    "clsx": "^2.1.1",
    "cytoscape": "^3.33.1",
    "emoji-picker-react": "^4.16.1",
    "framer-motion": "^12.38.0",
    "fuse.js": "^7.1.0",
    "heic2any": "^0.0.4",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.2.2",
    "katex": "^0.16.27",
    "lodash-es": "^4.17.21",
    "lucide-react": "^1.14.0",
    "mermaid": "^11.12.2",
    "nanoid": "^5.1.6",
    "next": "^16.2.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "spark-md5": "^3.0.2",
    "use-debounce": "^10.0.6",
    "zod": "^4.1.13",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.7",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/cytoscape": "^3.31.0",
    "@types/jest": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/spark-md5": "^3.0.5",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "csstype": "^3.2.3",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.2.7",
    "lodash": "^4.17.21",
    "postcss": "^8.5.14",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.61.0",
    "webpack": "^5.103.0"
  },
  "packageManager": "pnpm@11.0.9"
}
